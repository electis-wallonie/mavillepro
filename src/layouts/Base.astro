---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, CTA, PREVIEW, u } from '../lib/site';
import { PAYS, type P } from '../lib/pays';
// alternates : chemin de la même page dans chaque pays (balises hreflang)
type Props = { title: string; description: string; actif?: string; jsonld?: object[]; noindex?: boolean; pays?: P; alternates?: Partial<Record<P, string>> };
const { title, description, actif, jsonld = [], noindex = false, pays, alternates } = Astro.props;
const abs = (p: string) => new URL(u(p), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND, url: new URL(u('/'), Astro.site).href };
---
<!doctype html>
<html lang={pays ? PAYS[pays].locale : 'fr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates && Object.entries(alternates).map(([p, h]) => <link rel="alternate" hreflang={PAYS[p as P].locale} href={abs(h!)} />)}
  {alternates && <link rel="alternate" hreflang="x-default" href={abs('/')} />}
  {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0034B8" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={pays === 'be' ? 'fr_BE' : 'fr_FR'} />
  <meta property="og:site_name" content={BRAND} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
  <a class="sr" href="#contenu">Aller au contenu</a>
  <Header actif={actif} pays={pays} alternates={alternates} />
  <main id="contenu"><slot /></main>
  <Footer pays={pays} />
  {pays && <div class="sticky"><a class="btn btn-o" href="#devis">{CTA}</a></div>}
  <script>
    // Masque la barre « Être rappelé » quand un formulaire est déjà à l'écran
    const bar = document.querySelector<HTMLElement>('.sticky');
    const vus = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? vus.add(e.target) : vus.delete(e.target)));
      if (bar) bar.style.visibility = vus.size ? 'hidden' : 'visible';
    });
    document.querySelectorAll('.js-devis').forEach((f) => io.observe(f));
  </script>
</body>
</html>
