---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, CTA, PREVIEW, u } from '../lib/site';
type Props = { title: string; description: string; actif?: string; jsonld?: object[]; noindex?: boolean };
const { title, description, actif, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND, url: new URL(u('/'), Astro.site).href };
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0034B8" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={BRAND} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
  <a class="sr" href="#contenu">Aller au contenu</a>
  <Header actif={actif} />
  <main id="contenu"><slot /></main>
  <Footer />
  <div class="sticky"><a class="btn btn-o" href="#devis">{CTA}</a></div>
  <script>
    // Masque la barre « Être rappelé » quand un formulaire est déjà à l'écran
    const bar = document.querySelector<HTMLElement>('.sticky');
    const vus = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? vus.add(e.target) : vus.delete(e.target)));
      if (bar) bar.style.visibility = vus.size ? 'hidden' : 'visible';
    });
    document.querySelectorAll('.js-devis').forEach((f) => io.observe(f));
  </script>
</body>
</html>
