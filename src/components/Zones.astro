---
import { ZONES, VILLES_PHARES, parSlug } from '../data/communes';
import { LISTE_METIERS, type Metier } from '../data/metiers';
import { a } from '../lib/textes';
import { u } from '../lib/site';
type Props = { metier?: Metier; titre: string };
const { metier, titre } = Astro.props;
const ms = metier ? [metier] : LISTE_METIERS;
const m0 = metier ?? LISTE_METIERS[0];
---
<section class="sec" id="zones">
  <div class="wrap">
    <div class="head"><h2>{titre}</h2><span class="bar"></span><p>Nos artisans interviennent dans deux régions, villes et villages compris.</p></div>
    <div class="grid">
      {(['FR', 'BE'] as const).map((k) => (
        <div class="card zone">
          <h3>{ZONES[k].nom}</h3>
          <p class="mu">{ZONES[k].sous}</p>
          <ul>{VILLES_PHARES[k].map((s) => { const c = parSlug(s)!; return <li><a href={u(`/${m0.slug}/${s}/`)}>{metier ? `${metier.nom} ${a(c.nom)}` : c.nom}</a></li>; })}</ul>
          <p style="font-weight:700;margin-top:6px">Toutes les communes :</p>
          <ul>{ZONES[k].regions.flatMap((r) => ms.map((m) => <li><a href={u(`/${m.slug}/${r.slug}/`)}>{m.nom} · {r.nom}</a></li>))}</ul>
        </div>
      ))}
    </div>
  </div>
</section>
