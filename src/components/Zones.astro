---
import { ZONES, VILLES_PHARES, parSlug } from '../data/communes';
import { LISTE_METIERS, type Metier } from '../data/metiers';
import { a } from '../lib/textes';
import { u } from '../lib/site';
import { PAYS, type P } from '../lib/pays';
type Props = { metier?: Metier; titre: string; pays: P };
const { metier, titre, pays } = Astro.props;
const k = PAYS[pays].code;
const ms = metier ? [metier] : LISTE_METIERS;
const m0 = metier ?? LISTE_METIERS[0];
---
<section class="sec" id="zones">
  <div class="wrap">
    <div class="head"><h2>{titre}</h2><span class="bar"></span><p>{PAYS[pays].zone}, villes et villages compris.</p></div>
    <div class="grid">
      <div class="card zone">
        <h3>Villes principales</h3>
        <ul>{VILLES_PHARES[k].map((s) => { const c = parSlug(s)!; return <li><a href={u(`/${pays}/${m0.slug}/${s}/`)}>{metier ? `${metier.nom} ${a(c.nom)}` : c.nom}</a></li>; })}</ul>
      </div>
      <div class="card zone">
        <h3>Toutes les communes</h3>
        <ul>{ZONES[k].regions.flatMap((r) => ms.map((m) => <li><a href={u(`/${pays}/${m.slug}/${r.slug}/`)}>{m.nom} · {r.nom}</a></li>))}</ul>
      </div>
    </div>
  </div>
</section>
