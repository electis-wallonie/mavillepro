---
// Racine : renvoie directement vers /fr/ ou /be/, sans page de choix.
// Visiteur en Belgique (fuseau horaire ou langue du navigateur) -> /be/, sinon -> /fr/.
import { u } from '../lib/site';
const fr = u('/fr/');
const be = u('/be/');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>MaVillePro</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={new URL(fr, Astro.site).href} />
  <script is:inline define:vars={{ fr, be }}>
    var tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
    var langs = (navigator.languages || [navigator.language || '']).join(',');
    location.replace(tz === 'Europe/Brussels' || /-BE\b/i.test(langs) ? be : fr);
  </script>
  <meta http-equiv="refresh" content={`0;url=${fr}`} />
</head>
<body><p><a href={fr}>MaVillePro France</a> · <a href={be}>MaVillePro Belgique</a></p></body>
</html>
