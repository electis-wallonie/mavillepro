---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import DevisForm from '../../components/DevisForm.astro';
import Ouvrages from '../../components/Ouvrages.astro';
import Etapes from '../../components/Etapes.astro';
import Faq from '../../components/Faq.astro';
import Check from '../../components/Check.astro';
import Icon from '../../components/Icon.astro';
import { METIERS, LISTE_METIERS, type Metier } from '../../data/metiers';
import { COMMUNES, pageCommune, type Commune, type TexteMetier } from '../../data/communes';
import { faqLd, crumbLd, serviceLd } from '../../lib/seo';
import { BRAND, CTA, u } from '../../lib/site';

export function getStaticPaths() {
  return COMMUNES.flatMap((c) =>
    Object.entries(c.metiers).map(([k, t]) => ({ params: { metier: k, commune: c.slug }, props: { c, m: METIERS[k], t } })),
  );
}
const { c, m, t } = Astro.props as { c: Commune; m: Metier; t: TexteMetier };
const crumb: [string, string][] = [['Accueil', '/'], [m.nom, `/${m.slug}/`], [`${m.nom} à ${c.nom}`, `/${m.slug}/${c.slug}/`]];
const faq: [string, string][] = [
  ...(t.faq ?? []),
  ...m.faq,
  ['La demande de devis est-elle vraiment gratuite ?', 'Oui, la demande et le devis sont gratuits et sans engagement.'],
  ['Qui réalise les travaux ?', `Un artisan ${m.artisan} indépendant, qui intervient à ${c.nom} et alentour. ${BRAND} assure la mise en relation.`],
  ['Quand serai-je rappelé ?', "Sous 24 h après l'envoi de votre demande."],
];
const facteurs = [
  ["Le type d'ouvrage", 'et sa complexité'],
  ['Les dimensions', 'longueur, hauteur, surface'],
  ['Le matériau et la finition', 'couleur, remplissage, aspect'],
  ['La pose', 'accès au chantier, état du support'],
  ['Les options', 'motorisation, vitrage, accessoires'],
];
const autresMetiers = LISTE_METIERS.filter((x) => x.slug !== m.slug);
const site = Astro.site!;
const url = new URL(u(`/${m.slug}/${c.slug}/`), site).href;
---
<Base title={t.title} description={t.description} actif={m.slug}
  jsonld={[crumbLd(site, crumb, u), serviceLd({ nom: `${m.nom} à ${c.nom}`, description: t.description, zone: [c.nom, ...c.voisines], url }), faqLd(faq)]}>
  <Hero h1={t.h1} intro={t.intro} crumb={crumb}>
    <DevisForm tuiles={m.tuiles.map((slug) => ({ metier: m, slug }))} metiers={[m]} commune={c.nom} cp={c.cp} artisan={m.artisan} />
  </Hero>

  <section class="sec">
    <div class="wrap split">
      <div style="display:flex;flex-direction:column;gap:16px">
        <h2>Votre {m.artisan} à {c.nom} ({c.cp})</h2>
        <p class="mu">{t.local}</p>
      </div>
      <div class="card zone">
        <h3>Quartiers desservis à {c.nom}</h3>
        <ul>{c.quartiers.map((q) => <li>{q}</li>)}</ul>
      </div>
    </div>
  </section>

  <Ouvrages metier={m} nom={c.nom} complements={t.groupes} />

  <section class="sec">
    <div class="wrap split">
      <div style="display:flex;flex-direction:column;gap:16px">
        <h2>Combien coûte un ouvrage en {m.nom.toLowerCase()} à {c.nom} ?</h2>
        <p class="mu">Le prix dépend de plusieurs critères. Le montant exact vous est donné par écrit après la prise de mesures, avant tout engagement.</p>
        <ul class="list">{facteurs.map(([a, b]) => <li><Check /><span><strong>{a}</strong> <span class="mu">— {b}</span></span></li>)}</ul>
        <a class="btn btn-o" style="align-self:flex-start" href="#devis">Obtenir mon prix exact</a>
      </div>
      <div class="card" style="display:flex;flex-direction:column;gap:14px">
        <span class="ico"><Icon name="doc" color="#F8863D" /></span>
        <strong style="font-size:20px;color:#0034B8">Un devis écrit, avant tout engagement</strong>
        <p class="mu">L'artisan se déplace à {c.nom} pour mesurer et voir le support. Vous recevez ensuite un devis détaillé, gratuit, que vous êtes libre d'accepter ou non.</p>
      </div>
    </div>
  </section>

  <Etapes titre={`Comment se déroule votre projet de ${m.nom.toLowerCase()} à ${c.nom} ?`} artisan={m.artisan} />

  <section class="sec blue">
    <div class="wrap">
      <div class="head"><h2>Pourquoi passer par {BRAND} à {c.nom} ?</h2><span class="bar"></span></div>
      <div class="grid">
        {[
          ['Un artisan local', `Un ${m.artisan} du ${c.region} qui connaît ${c.nom} et ses quartiers.`],
          ['Rappel sous 24 h', 'Votre demande est transmise tout de suite.'],
          ['Devis écrit et gratuit', 'Prix validé avant tout démarrage des travaux.'],
          ['Sur mesure', 'Fabrication aux dimensions exactes, pose comprise.'],
        ].map(([a, b]) => <div class="why"><span class="chk" style="width:44px;height:44px;border-radius:12px"><Icon name="check" color="#1a1a1a" stroke={3} /></span><strong>{a}</strong><span>{b}</span></div>)}
      </div>
      <a class="btn btn-o" style="align-self:center" href="#devis">{CTA}</a>
    </div>
  </section>

  <section class="sec alt" id="zone">
    <div class="wrap">
      <div class="head"><h2>Nous intervenons aussi autour de {c.nom}</h2><span class="bar"></span></div>
      <div class="chips">
        {c.voisines.map((v) => { const h = pageCommune(m.slug, v); return h ? <a href={u(h)}>{m.nom} à {v}</a> : <span>{v}</span>; })}
      </div>
    </div>
  </section>

  <Faq titre={`Questions fréquentes sur la ${m.nom.toLowerCase()} à ${c.nom}`} items={faq} />

  <section class="sec alt">
    <div class="wrap split">
      <div style="display:flex;flex-direction:column;gap:16px">
        <h2>Demandez votre devis {m.nom.toLowerCase()} à {c.nom}</h2>
        <p class="mu">Décrivez votre projet en une minute. Un {m.artisan} vous rappelle sous 24 h.</p>
        <h3 style="font-size:18px;margin-top:8px">Nos autres services à {c.nom}</h3>
        <ul class="list">
          {autresMetiers.map((x) => { const h = pageCommune(x.slug, c.nom); return <li><Check /><span>{h ? <a href={u(h)}>{x.nom} à {c.nom}</a> : <a href={u(`/${x.slug}/`)}>{x.nom}</a>} <span class="mu">— {x.accroche}</span></span></li>; })}
        </ul>
      </div>
      <DevisForm id="devis-bas" tuiles={m.tuiles.map((slug) => ({ metier: m, slug }))} metiers={[m]} commune={c.nom} cp={c.cp} artisan={m.artisan} />
    </div>
  </section>
</Base>
