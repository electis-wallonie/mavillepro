---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DevisForm from '../components/DevisForm.astro';
import { METIERS as M, LISTE_METIERS } from '../data/metiers';
import { BRAND } from '../lib/site';
const tuiles = [
  { metier: M.metallerie, slug: 'portail-battant' }, { metier: M.metallerie, slug: 'garde-corps' }, { metier: M.metallerie, slug: 'escalier-droit' },
  { metier: M.menuiserie, slug: 'fenetre' }, { metier: M.menuiserie, slug: 'porte-entree' }, { metier: M.menuiserie, slug: 'volet-roulant' },
  { metier: M.vitrerie, slug: 'vitre-cassee' }, { metier: M.metallerie, slug: 'autre' },
];
---
<Base title={`Demande de devis gratuit – réponse sous 24 h | ${BRAND}`} description="Décrivez votre projet de métallerie, menuiserie ou vitrerie : un artisan de votre secteur vous rappelle sous 24 h. Gratuit et sans engagement.">
  <Hero h1="Demandez votre devis gratuit" intro="Choisissez votre projet et laissez vos coordonnées : un artisan de votre secteur vous rappelle sous 24 h." crumb={[['Accueil', '/'], ['Demande de devis', '/devis/']]}>
    <DevisForm tuiles={tuiles} metiers={LISTE_METIERS} />
  </Hero>
</Base>
